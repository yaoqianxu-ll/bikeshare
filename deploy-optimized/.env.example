# ==================== 环境变量配置 ====================
# 复制此文件为 .env 并修改为实际值

# ==================== MySQL 配置 ====================
MYSQL_ROOT_PASSWORD=your-secure-root-password-here
MYSQL_DATABASE=bikeshare
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-secure-db-password-here

# ==================== Redis 配置 ====================
REDIS_PASSWORD=your-secure-redis-password-here
APP_REDIS_KEY_PREFIX=bikeshare:prod:

# ==================== RabbitMQ 配置 ====================
RABBITMQ_USERNAME=bikeshare
RABBITMQ_PASSWORD=your-secure-rabbitmq-password-here

# ==================== MinIO 配置 ====================
MINIO_ROOT_USER=bikeshare-admin
MINIO_ROOT_PASSWORD=your-secure-minio-password-here
MINIO_BUCKET=bicycles
MINIO_ENDPOINT=http://minio:9000

# ==================== JWT 配置 ====================
# 生成方法：openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long
JWT_PREVIOUS_SECRETS=

# ==================== 邮件配置 ====================
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-auth-code
MAIL_FROM_NAME=BikeShare

# ==================== 服务器配置 ====================
SERVER_HOST=bikeshare.online

# ==================== 备份配置 ====================
BACKUP_RETENTION_DAYS=7
BACKUP_TIME=03:00

# ==================== Jenkins 配置 ====================
JENKINS_ADMIN_PASSWORD=your-jenkins-admin-password
