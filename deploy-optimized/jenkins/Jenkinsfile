pipeline {
    agent any

    environment {
        // 项目配置
        PROJECT_NAME = 'bikeshare-optimized'
        DEPLOY_DIR = 'deploy-optimized'
        BACKEND_DIR = 'bickdemo-backend'
        FRONTEND_DIR = 'bickdemo-frontend'
        ADMIN_DIR = 'bickdemo-admin'
    }

    options {
        // 保留最近的构建记录
        buildDiscarder(logRotator(numToKeepStr: '10'))
        // 超时时间
        timeout(time: 45, unit: 'MINUTES')
        // 禁止并发构建
        disableConcurrentBuilds()
        // 避免自动 checkout，我们自己控制
        skipDefaultCheckout(true)
        // 构建超时后终止子进程
        terminate('TIMEOUT')
    }

    triggers {
        // Git Hook 触发 (需要在 Gitee/GitHub 配置 Webhook)
        pollSCM('*/5 * * * *')  // 每 5 分钟检查一次代码变更
        // 定时构建 (每天凌晨 2 点)
        cron('0 2 * * *')
    }

    parameters {
        booleanParam(name: 'SKIP_BUILD', defaultValue: false, description: '跳过前后端构建与镜像构建，仅执行 docker-compose up -d 进行部署')
        booleanParam(name: 'CLEAN_WORKSPACE', defaultValue: false, description: '构建前清空 Jenkins 工作区')
        booleanParam(name: 'BACKUP_BEFORE_DEPLOY', defaultValue: true, description: '部署前先备份数据')
        choice(name: 'DEPLOY_TARGET', choices: ['all', 'frontend', 'admin', 'backend'], description: '部署目标')
    }

    stages {
        stage('Checkout') {
            steps {
                echo '📦 拉取代码...'
                script {
                    if (params.CLEAN_WORKSPACE) {
                        echo '🧹 CLEAN_WORKSPACE=true，清空工作区...'
                        cleanWs()
                    }
                }
                checkout scm
                script {
                    // 加载环境变量文件
                    String envFilePath = null
                    List<String> envCandidates = [
                        '.env',
                        'deploy-optimized/.env',
                        'deploy-optimized/.env.example'
                    ]

                    for (String candidate : envCandidates) {
                        if (fileExists(candidate)) {
                            envFilePath = candidate
                            break
                        }
                    }

                    if (envFilePath) {
                        echo "加载环境文件：${envFilePath}"
                        // 解析环境变量
                        def envContent = readFile(envFilePath).split('\n')
                        envContent.each { line ->
                            line = line.trim()
                            if (line && !line.startsWith('#') && line.contains('=')) {
                                int idx = line.indexOf('=')
                                String key = line.substring(0, idx).trim()
                                String value = line.substring(idx + 1).trim()
                                if (key && value) {
                                    env."${key}" = value
                                }
                            }
                        }
                    }

                    // 获取 Git 提交信息
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_BRANCH_NAME = env.BRANCH_NAME ?: 'main'
                }
                echo "✅ 代码拉取完成 | 分支：${env.GIT_BRANCH_NAME} | 提交：${env.GIT_COMMIT_SHORT}"
            }
        }

        stage('Prepare') {
            steps {
                echo '🔧 准备构建环境...'
                sh 'docker --version'
                sh 'docker-compose --version'
            }
        }

        stage('Backup Data') {
            when {
                expression {
                    return params.BACKUP_BEFORE_DEPLOY && !params.SKIP_BUILD
                }
            }
            steps {
                echo '💾 备份现有数据...'
                script {
                    try {
                        sh '''
                            cd ${DEPLOY_DIR}
                            if [ -f scripts/backup.sh ]; then
                                bash scripts/backup.sh || echo "备份完成 (可能有警告)"
                            else
                                echo "备份脚本不存在，跳过备份"
                            fi
                        '''
                    } catch (Exception e) {
                        echo "备份过程中出现警告：${e.message}"
                    }
                }
            }
        }

        stage('Stop Containers') {
            steps {
                echo '🛑 停止现有容器...'
                sh '''
                    cd ${DEPLOY_DIR}
                    docker-compose down || true
                    echo "等待容器停止..."
                    sleep 5
                '''
            }
        }

        stage('Build Backend') {
            when {
                expression {
                    return !params.SKIP_BUILD && (params.DEPLOY_TARGET == 'all' || params.DEPLOY_TARGET == 'backend')
                }
            }
            steps {
                echo '🔨 构建后端...'
                dir("${BACKEND_DIR}") {
                    sh '''
                        echo "Maven 版本："
                        mvn --version

                        echo "清理并构建..."
                        mvn clean package -DskipTests -B -o || mvn clean package -DskipTests -B

                        echo "检查构建产物..."
                        ls -lh target/*.jar || echo "未找到 jar 包"
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: "${BACKEND_DIR}/target/*.jar", allowEmptyArchive: true
                    echo "✅ 后端构建完成"
                }
                failure {
                    echo "❌ 后端构建失败"
                }
            }
        }

        stage('Build Frontend') {
            when {
                expression {
                    return !params.SKIP_BUILD && (params.DEPLOY_TARGET == 'all' || params.DEPLOY_TARGET == 'frontend')
                }
            }
            steps {
                echo '🎨 构建前端...'
                dir("${FRONTEND_DIR}") {
                    sh '''
                        echo "Node.js 版本："
                        node --version
                        echo "npm 版本："
                        npm --version

                        echo "安装依赖..."
                        npm install --legacy-peer-deps

                        echo "构建..."
                        npx vite build

                        echo "检查产物..."
                        ls -lh dist/
                    '''
                }
            }
            post {
                success {
                    echo "✅ 前端构建完成"
                }
            }
        }

        stage('Build Admin') {
            when {
                expression {
                    return !params.SKIP_BUILD && (params.DEPLOY_TARGET == 'all' || params.DEPLOY_TARGET == 'admin')
                }
            }
            steps {
                echo '🛠️ 构建管理端...'
                dir("${ADMIN_DIR}") {
                    sh '''
                        echo "Node.js 版本："
                        node --version
                        echo "npm 版本："
                        npm --version

                        echo "安装依赖..."
                        npm install --legacy-peer-deps

                        echo "构建..."
                        npx vite build

                        echo "检查产物..."
                        ls -lh dist/
                    '''
                }
            }
            post {
                success {
                    echo "✅ 管理端构建完成"
                }
            }
        }

        stage('Build Docker Images') {
            when {
                expression {
                    return !params.SKIP_BUILD && params.DEPLOY_TARGET == 'all'
                }
            }
            steps {
                echo '🐳 构建 Docker 镜像...'
                dir("${DEPLOY_DIR}") {
                    sh '''
                        echo "构建镜像（使用缓存加速）..."
                        docker-compose build

                        echo "镜像列表:"
                        docker images | grep bikeshare
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 部署应用...'
                dir("${DEPLOY_DIR}") {
                    sh """
                        echo "启动服务..."
                        docker-compose up -d --remove-orphans --force-recreate

                        echo "等待服务启动..."
                        sleep 15

                        echo "检查容器状态..."
                        docker-compose ps

                        echo "查看最近日志..."
                        docker-compose logs --tail=20
                    """
                }
            }
        }

        stage('Health Check') {
            steps {
                echo '🏥 健康检查...'
                script {
                    // 等待服务启动
                    sleep 30

                    // 检查各个服务
                    def services = [
                        'http://localhost/health': 'Nginx',
                        'http://localhost:8080/actuator/health': 'Backend API'
                    ]

                    services.each { url, name ->
                        try {
                            def response = sh(script: "curl -s -o /dev/null -w '%{http_code}' ${url}", returnStdout: true).trim()
                            if (response == '200') {
                                echo "✅ ${name} 健康检查通过"
                            } else {
                                echo "⚠️ ${name} 返回状态码：${response}"
                            }
                        } catch (Exception e) {
                            echo "⚠️ ${name} 健康检查失败：${e.message}"
                        }
                    }
                }
            }
        }

        stage('Cleanup') {
            steps {
                echo '🧹 清理构建缓存...'
                sh '''
                    # 清理悬空镜像
                    docker image prune -f

                    # 清理停止的容器
                    docker container prune -f
                '''
            }
        }
    }

    post {
        always {
            echo '📊 构建完成'
            // 发送通知 (可扩展为邮件、钉钉、企业微信等)
        }
        success {
            echo '✅ 部署成功！'
            script {
                def currentTime = new Date().format('yyyy-MM-dd HH:mm:ss', TimeZone.getTimeZone('Asia/Shanghai'))
                echo "部署完成时间：${currentTime}"
                echo ""
                echo "访问地址："
                echo "  用户端：https://bikeshare.online"
                echo "  管理端：https://admin.bikeshare.online"
                echo "  MinIO:   https://minio.bikeshare.online"
                echo "  Jenkins: http://服务器 IP:8081"
            }
        }
        failure {
            echo '❌ 构建失败，请查看控制台输出'
            // 可以添加失败通知
        }
        unstable {
            echo '⚠️ 构建不稳定，部分服务可能未正常启动'
        }
    }
}
