# Jenkins 环境变量配置
# 复制此文件为 .env 并修改为实际值

# ==================== Jenkins 管理员密码 ====================
# 首次启动后可以在 Jenkins 中修改
JENKINS_ADMIN_PASSWORD=your-jenkins-admin-password

# ==================== Git 仓库配置 ====================
# 用于 Jenkins 拉取代码
GIT_REPO_URL=http://your-gitea-host:3000/username/bickdemo.git
GIT_USERNAME=your-git-username
GIT_PASSWORD=your-git-password

# ==================== 部署配置 ====================
# 项目根目录（相对于 Jenkins 工作空间）
DEPLOY_DIR=deploy-optimized

# ==================== Docker 配置 ====================
# Docker 镜像前缀
DOCKER_IMAGE_PREFIX=bikeshare

# ==================== 通知配置（可选） ====================
# 钉钉/企业微信 Webhook
DINGTALK_WEBHOOK=
WECHAT_WEBHOOK=
