# Production environment example

SPRING_PROFILES_ACTIVE=prod

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-prod-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-prod-redis-password
REDIS_DATABASE=0
APP_REDIS_KEY_PREFIX=bickdemo:prod:

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace-with-prod-user
RABBITMQ_PASSWORD=replace-with-prod-password

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-prod-access-key
MINIO_SECRET_KEY=replace-with-prod-secret-key
MINIO_BUCKET=bicycles

JWT_SECRET=replace-with-prod-jwt-secret
