# Copy this file to `.env` before local or Docker deployment.
# On servers/Jenkins, you can also keep it outside the repo and point
# `BICKDEMO_ENV_FILE` to that file, or place it at `$HOME/.bickdemo.env`.
# Replace every `change-me-*` placeholder with your own secret values.

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=bickdemo
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me-root-password
MYSQL_ROOT_PASSWORD=change-me-root-password

REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 默认不开 ACL 用户名；只有你显式配置过 ACL 用户时才填写。
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
APP_REDIS_KEY_PREFIX=bickdemo:prod:

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

JWT_SECRET=change-me-jwt-secret-with-at-least-32-bytes
JWT_PREVIOUS_SECRETS=

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=bicycles

MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-auth-code
MAIL_FROM_NAME=BikeShare


GAODE_MAP_API_KEY=your-gaode-api-key

DEPLOY_HOST=your-server-host
DEPLOY_USER=root
APP_PUBLIC_HOST=http://localhost
ADMIN_PUBLIC_HOST=http://localhost:3001
BACKEND_PUBLIC_HOST=http://localhost:8080
MINIO_PUBLIC_HOST=http://localhost:9000
JENKINS_PUBLIC_HOST=http://localhost:8081
GITEA_PUBLIC_HOST=http://localhost:3000

GITEA_DATABASE_HOST=mysql:3306
GITEA_DATABASE_NAME=gitea
GITEA_DATABASE_USER=gitea
GITEA_DATABASE_PASSWORD=change-me-gitea-db-password
